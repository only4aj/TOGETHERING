{

    "functions": [{
    "api/**/*.js": {
      "runtime": "nodejs16.x"
    }
    }],

    "builds": [{

        "src": "TOGETHERING/asgi.py",

        "use": "@vercel/python",

        "config": { "maxLambdaSize": "15mb", "runtime": "python3.9" }

    }],

    "routes": [

        {

            "src": "/(.*)",

            "dest": "TOGETHERING/asgi.py"

        }

    ]

}